@startuml arquitectura-secureshop
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Helvetica
skinparam roundcorner 8
skinparam componentBorderColor #1F4E79
skinparam databaseBorderColor #1F4E79
skinparam ArrowColor #1F4E79

title SecureShop · la aplicación que usamos

actor "Navegador" as nav
component "Aplicación\n<b>secureshop.py :5002</b>\nlogin, tienda, carrito,\ninscribir, estadísticas" as app
component "API de mascotas\n<b>api.py :5001</b>\nregistrar y listar" as api
database "SQLite\nsecure_shop.db" as db

nav --> app : una puerta\n/login
app --> api : HTTP
api --> db

note bottom of app
  SecureShopRefactorizadoMVC/ está en el repo.
  No la usamos.
end note

@enduml
