# Copia este archivo a .env y ajusta los valores. NO se commitea .env.
# Sprint 1 · chore: sacar secretos y credenciales del código (hallazgo H2).

# Clave para firmar la sesión del panel (usa una cadena larga y aleatoria).
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Credenciales iniciales del administrador (se siembran en la BD, hasheadas).
ADMIN_USER=admin
ADMIN_PASSWORD=colocolo

# Ruta de la base SQLite y URL de la API de datos.
SECURE_SHOP_DB=secure_shop.db
API_URL=http://localhost:5001
